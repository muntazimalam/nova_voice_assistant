# Nova AI Voice Assistant — configuration template
# Copy this file to .env and fill in real values.

# Google Gemini (required — get a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# LLM — primary should be the fastest tier for snappy replies (gemini-3.1-
# flash-lite). The retired 2.0/2.5-flash tiers now return 404, so don't pin them.
#GEMINI_MODEL=gemini-3.1-flash-lite
# The google-genai SDK defaults to 5 attempts with exponential backoff up to 60s,
# which silently turns one transient error into a ~15s stall. Tightened here:
#LLM_TIMEOUT_SECONDS=15
#GEMINI_HTTP_TIMEOUT_MS=10000
#GEMINI_RETRY_ATTEMPTS=2
#GEMINI_RETRY_INITIAL_DELAY=0.2
#GEMINI_RETRY_MAX_DELAY=0.5
# OPT-IN: race the primary and first fallback, take whoever emits the first
# token. We measured this SLOWER on free-tier keys (concurrency throttling) —
# leave off unless your plan handles concurrent requests well.
#GEMINI_RACE_FALLBACK=false

# STT — "base" is far more robust than "tiny" for real laptop mics (one-time ~150 MB download)
#WHISPER_MODEL=base
#WHISPER_LANGUAGE=en
#WHISPER_NORMALIZE=true

# TTS — "edge" (cloud MP3, fast, default) is the recommended out-of-the-box
#        option. "xtts" (local neural, most human, ~1.6 GB model, slow on CPU)
#        and "piper" (local WAV) are optional.
# XTTS needs the model to have been downloaded once AND the CPML license flag:
#   COQUI_TOS_AGREED=1
#TTS_ENGINE=edge
#TTS_XTTS_SPEAKER=Daisy Studious
#TTS_XTTS_LANGUAGE=en
#TTS_VOICE=en-US-JennyNeural
#TTS_RATE=+4%
#TTS_PITCH=+0Hz
#TTS_VOLUME=+0%
#PIPER_MODEL_PATH=models/piper/en_US-lessac-medium.onnx
#PIPER_CONFIG_PATH=models/piper/en_US-lessac-medium.onnx.json

# Wake word
#WAKE_STRATEGY=auto
#WAKE_PHRASES=["hey nova","nova"]

# Capture timing (ms)
#SILENCE_TIMEOUT_MS=450
#MIN_COMMAND_MS=250
#MAX_COMMAND_MS=12000
# Voice trigger sensitivity: min RMS (16-bit int) to count as speech. Your real
# room noise sits above 250 — raise if capture starts without you speaking.
#WAKE_RMS_THRESHOLD=800
# Voiced chunks (~20 ms each) required before a capture starts; rejects single noise bursts.
#VOICE_DEBOUNCE_FRAMES=3

# ── Advanced Audio Pipeline ──────────────────────────────────────────────────
# Opus codec for bandwidth-efficient streaming (auto-falls back to PCM).
#USE_OPUS_CODEC=true
# Silero VAD for precision endpointing (auto-falls back to RMS).
#USE_SILERO_VAD=true
# Acoustic echo cancellation for barge-in. The browser strips its own TTS
# output from the mic (echoCancellation), so this is a secondary server-side
# guard. Consecutive voiced chunks required before barge-in interrupts a reply:
#BARGE_IN_REQUIRED_FRAMES=5
# Ignore barge-in for this long after a reply starts (ms) — Nova's own voice
# echoing into the mic during the first syllable defeats echo gates.
#BARGE_IN_GRACE_MS=600
# While TTS audio is actively flowing to the client, barge-in is ignored until
# this silence gap (ms). This makes self-truncation impossible: a continuous
# echo can never count as user input, but real inter-clause interruptions work.
#BARGE_IN_GAP_MS=250
#USE_ECHO_CANCELLATION=true

# ── Conversation & sessions ─────────────────────────────────────────────────
# Ceiling on reply length in tokens (the model can otherwise speak as long as
# it likes). 0 disables the limit entirely.
#LLM_MAX_OUTPUT_TOKENS=2048
# How long a disconnected session's history is kept before it is pruned.
#SESSION_TTL_SECONDS=3600

# ── LLM Response Caching ─────────────────────────────────────────────────────
# Cache identical queries to serve instant responses without hitting Gemini.
#LLM_CACHE_ENABLED=true
#LLM_CACHE_MAX_SIZE=1000
#LLM_CACHE_TTL_SECONDS=3600

# ── Conversation Summarization ───────────────────────────────────────────────
# Summarize old turns to keep long conversations within token limits.
#CONVERSATION_SUMMARY_ENABLED=false
#CONVERSATION_SUMMARY_TURNS=8

# ── Rate Limiting ────────────────────────────────────────────────────────────
#RATE_LIMIT_ENABLED=true
#RATE_LIMIT_MAX_REQUESTS=120
#RATE_LIMIT_WINDOW_SECONDS=60

# ── Observability ────────────────────────────────────────────────────────────
#STRUCTURED_LOGGING=true